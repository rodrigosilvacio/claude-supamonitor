# ---------------------------------------------------------------------------
# Supabase Monitor: variáveis de ambiente (NUNCA commitar valores reais)
# ---------------------------------------------------------------------------

# --- Frontend (Vite / GitHub Pages) -----------------------------------------
# Públicos por desenho (protegidos por Auth + RLS). No GitHub, use Actions *Variables*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Edge Functions (definir como secrets no projeto Supabase do monitor) ---
# Personal Access Token da conta Supabase (Management API, somente GET de advisors)
MONITOR_SUPABASE_PAT=
# Segredo compartilhado entre pg_cron e as Edge Functions de coleta (etapa 2+)
MONITOR_CRON_SECRET=
# Notificações (etapa 4)
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
WHATSAPP_WEBHOOK_URL=
