{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["supabase/functions/_shared/core/**/*.ts", "frontend/src/lib/security.ts", "frontend/src/lib/metrics.ts", "tests/**/*.ts"]
}
